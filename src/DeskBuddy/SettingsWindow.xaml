<Window x:Class="DeskBuddy.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="680" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A8A8B0"/>
        <SolidColorBrush x:Key="HoverBg" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="SelectedBg" Color="#3D5EB2FF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="FooterBrush" Color="#909098"/>
        <SolidColorBrush x:Key="CardBg" Color="#CC1E1E1E"/>
        <SolidColorBrush x:Key="BtnBg" Color="#26FFFFFF"/>

        <!-- AI 标识渐变（与主菜单一致） -->
        <LinearGradientBrush x:Key="AiGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7A5CFF" Offset="0"/>
            <GradientStop Color="#2A6DF4" Offset="0.55"/>
            <GradientStop Color="#32D583" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BtnBgHover" Color="#3DFFFFFF"/>
        <SolidColorBrush x:Key="AccentBg" Color="#2A6DF4"/>

        <Style x:Key="MacButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnBgHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource MacButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBg}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6" Padding="12,4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DotButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧目录按钮 -->
        <Style x:Key="CategoryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 设置项左标签 / 面板介绍小字（自动换行，防止长介绍横向溢出面板） -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 输入框 -->
        <Style x:Key="MacTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard" CornerRadius="24" BorderThickness="1"
            BorderBrush="{DynamicResource CardBorder}"
            Background="{DynamicResource CardBg}"
            MouseLeftButtonDown="OnCardMouseDown"
            MouseMove="OnCardMouseMove"
            MouseLeftButtonUp="OnCardMouseUp">
        <Grid Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（macOS 红黄绿） -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource DotButton}" Tag="close" Click="OnDotClick">
                        <Ellipse Width="12" Height="12" Fill="#FF5F57"/>
                    </Button>
                    <Button Style="{StaticResource DotButton}" Tag="min" Click="OnDotClick">
                        <Ellipse Width="12" Height="12" Fill="#FEBC2E"/>
                    </Button>
                    <Button Style="{StaticResource DotButton}" Tag="zoom" Click="OnDotClick">
                        <Ellipse Width="12" Height="12" Fill="#28C840"/>
                    </Button>
                </StackPanel>
                <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- 主体：左侧目录 + 右侧内容 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="152"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== 左侧目录 ===== -->
                <StackPanel Grid.Column="0" Margin="2,4,10,0">
                    <Button x:Name="CatGeneral" Style="{StaticResource CategoryButton}" Tag="general" Click="OnCategoryClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="通用" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CatSearch" Style="{StaticResource CategoryButton}" Tag="search" Click="OnCategoryClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="搜索" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CatAi" Style="{StaticResource CategoryButton}" Tag="ai" Click="OnCategoryClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✨" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="AI 对话" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CatMcp" Style="{StaticResource CategoryButton}" Tag="mcp" Click="OnCategoryClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="AI 快捷添加" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CatItems" Style="{StaticResource CategoryButton}" Tag="items" Click="OnCategoryClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="菜单项" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="{DynamicResource SeparatorBrush}"/>

                <!-- ===== 右侧内容 ===== -->
                <Grid Grid.Column="2" Margin="18,0,2,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">

                            <!-- ========== 通用 ========== -->
                            <StackPanel x:Name="PanelGeneral">
                                <TextBlock Text="通用" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="呼出方式、双击灵敏度和外观主题" Style="{StaticResource FieldLabel}" Margin="0,3,0,0"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="呼出快捷键" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="HotkeyHint"
                                                   Text="点击右侧按钮，再直接按下 Ctrl / Alt / Shift / CapsLock / Win"
                                                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="HotkeyBtn" Grid.Column="1" Style="{StaticResource MacButton}"
                                            MinWidth="112" Height="36" Click="OnHotkeyCaptureClick"
                                            Content="Ctrl" FontSize="13"/>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="双击判定间隔" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="IntervalLabel" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Slider x:Name="IntervalSlider" Grid.Column="1" Width="176" Minimum="200" Maximum="600"
                                            TickFrequency="20" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="OnIntervalChanged"/>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="外观主题" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="跟随系统 / 浅色 / 深色" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource BtnBg}" Padding="2" VerticalAlignment="Center">
                                        <UniformGrid Columns="3">
                                            <RadioButton x:Name="ThemeAuto" Content="自动" GroupName="ThemeGroup"
                                                         Style="{StaticResource SegmentRadio}" IsChecked="True" Checked="OnThemeChanged"/>
                                            <RadioButton x:Name="ThemeLight" Content="浅色" GroupName="ThemeGroup"
                                                         Style="{StaticResource SegmentRadio}" Checked="OnThemeChanged"/>
                                            <RadioButton x:Name="ThemeDark" Content="深色" GroupName="ThemeGroup"
                                                         Style="{StaticResource SegmentRadio}" Checked="OnThemeChanged"/>
                                        </UniformGrid>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="条目排布" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="宫格（现状）/ 宫格（填充整行）/ 列表" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource BtnBg}" Padding="2" VerticalAlignment="Center">
                                        <UniformGrid Columns="3">
                                            <RadioButton x:Name="LayoutGrid" Content="宫格" GroupName="LayoutGroup"
                                                         Style="{StaticResource SegmentRadio}" IsChecked="True"/>
                                            <RadioButton x:Name="LayoutFill" Content="填充" GroupName="LayoutGroup"
                                                         Style="{StaticResource SegmentRadio}"/>
                                            <RadioButton x:Name="LayoutList" Content="列表" GroupName="LayoutGroup"
                                                         Style="{StaticResource SegmentRadio}"/>
                                        </UniformGrid>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- ========== 搜索 ========== -->
                            <StackPanel x:Name="PanelSearch" Visibility="Collapsed">
                                <TextBlock Text="文件搜索" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,3,0,0"
                                           Text="在菜单搜索时，除了匹配快捷菜单条目，还会在你指定的目录里搜索文件（结果以「文件」分区显示在下方，不干扰菜单条目）"/>

                                <CheckBox x:Name="EnableFileSearchBox" Margin="0,12,0,0"
                                          Content="启用文件搜索（在指定范围内按文件名匹配）"
                                          FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>

                                <TextBlock Text="搜索范围（每行一个目录路径，支持环境变量）" Style="{StaticResource FieldLabel}" Margin="0,14,0,4"/>
                                <TextBox x:Name="SearchRootsBox" Height="120"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource MacTextBox}"
                                         ToolTip="每行一个路径，例如：D:\ 或 E:\work 或 %USERPROFILE%\Desktop。留空 = 不搜索文件。"/>

                                <TextBlock Text="搜索后端" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                                <ComboBox x:Name="SearchBackendBox" Height="30" FontSize="12"
                                          Foreground="{DynamicResource TextPrimary}"
                                          Background="{DynamicResource BtnBg}"
                                          BorderBrush="{DynamicResource CardBorder}"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Tag="auto" Content="自动（优先自有 USN 引擎，其次 Windows Search，最后内置索引）"/>
                                    <ComboBoxItem Tag="usn" Content="自有索引引擎（USN，不依赖 Windows Search，秒级全盘）"/>
                                    <ComboBoxItem Tag="wsearch" Content="Windows Search 系统索引"/>
                                </ComboBox>

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,0"
                                           Text="提示：自有引擎通过 NTFS USN 日志枚举文件名（Listary 同技术），首次构建约数十秒，之后毫秒级搜索、完全独立于 Windows Search；Windows Search 后端需先把目录加入系统「索引选项」。" />
                            </StackPanel>

                            <!-- ========== AI 对话 ========== -->
                            <StackPanel x:Name="PanelAi" Visibility="Collapsed">
                                <TextBlock Text="AI 对话" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>

                                <!-- DeepSeek Harness 强调徽章条 -->
                                <Border Margin="0,10,0,0" CornerRadius="10" Padding="12,9"
                                        Background="#12FFFFFF" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="9" Padding="8,4" Background="{StaticResource AiGradient}" VerticalAlignment="Center">
                                            <TextBlock Text="DeepSeek Harness" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Margin="10,0,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                                                   Text="AI 对话由 DeepSeek Harness 驱动 · 本机运行，数据不出电脑"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="AiHint" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>

                                <Grid x:Name="HarnessAddrRow" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Harness 地址" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="HarnessBaseUrlBox" Grid.Column="1" Style="{StaticResource MacTextBox}" Height="28"/>
                                </Grid>
                                <Grid x:Name="HarnessSessionRow" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="会话策略" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="HarnessSessionBox" Grid.Column="1" Style="{StaticResource MacTextBox}" Height="28"/>
                                </Grid>
                                <CheckBox x:Name="ShowAllSessionsRow" Margin="84,10,0,0"
                                          Content="会话列表显示全部会话（默认只显示「桌面助手」分组）"
                                          FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- ========== AI 快捷添加（MCP） ========== -->
                            <StackPanel x:Name="PanelMcp" Visibility="Collapsed">
                                <TextBlock Text="AI 快捷添加（MCP）" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,3,0,0"
                                           Text="允许 Claude Desktop / Cursor / Cherry Studio 等 AI 工具查看、添加、删除快捷菜单，仅本机可访问"/>
                                <CheckBox x:Name="McpEnabledBox" Margin="0,12,0,0"
                                          Content="允许 AI 工具通过 MCP 添加/删除快捷菜单（默认开启）"
                                          FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="CopyMcpBtn" Style="{StaticResource MacButton}" Content="复制接入配置"
                                            Click="OnCopyMcpConfig" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="McpHint" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- ========== 菜单项 ========== -->
                            <StackPanel x:Name="PanelItems" Visibility="Collapsed"
                                        AllowDrop="True"
                                        DragEnter="OnItemsDragEnter" DragOver="OnItemsDragOver"
                                        DragLeave="OnItemsDragLeave" Drop="OnItemsDrop">
                                <TextBlock Text="菜单项" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="ItemsHint" Style="{StaticResource FieldLabel}" Margin="0,3,0,0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-32,0,0">
                                    <Button x:Name="AddItemBtn" Style="{StaticResource MacButton}" Content="添加" Click="OnAddItem" Margin="0,0,6,0"/>
                                    <Button x:Name="EditItemBtn" Style="{StaticResource MacButton}" Content="编辑" Click="OnEditItem" Margin="0,0,6,0"/>
                                    <Button x:Name="DelItemBtn" Style="{StaticResource MacButton}" Content="删除" Click="OnDeleteItem"/>
                                </StackPanel>

                                <Border x:Name="DropHighlight" CornerRadius="9"
                                        BorderBrush="{DynamicResource AccentBg}" BorderThickness="2"
                                        Margin="0,8,0,6" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.65">
                                    <TextBlock Text="松开以添加" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <ListBox x:Name="ItemList" Height="280" Margin="0,8,0,6" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="OnItemsSelectionChanged" MouseDoubleClick="OnItemDoubleClick"
                                         PreviewMouseLeftButtonDown="OnListPreviewMouseDown" PreviewMouseLeftButtonUp="OnListPreviewMouseUp">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,5"/>
                                            <Setter Property="Margin" Value="0,1"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" CornerRadius="8"
                                                                Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7"
                                                        Background="{Binding IconBg}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource GlyphStyle}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="UpBtn" Style="{StaticResource MacButton}" Content="上移" Click="OnMoveUp" Margin="0,0,6,0"/>
                                    <Button x:Name="DownBtn" Style="{StaticResource MacButton}" Content="下移" Click="OnMoveDown"/>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- 底部按钮 -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="SaveHint" Text="保存后立即生效"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Style="{StaticResource MacButton}" Content="取消"
                            Click="OnCancel" Margin="0,0,10,0"/>
                    <Button x:Name="SaveBtn" Style="{StaticResource AccentButton}" Content="保存"
                            Click="OnSave"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
