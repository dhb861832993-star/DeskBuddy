<Window x:Class="DeskBuddy.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 助手"
        Width="580" Height="580" MinWidth="440" MinHeight="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A8A8B0"/>
        <SolidColorBrush x:Key="HoverBg" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="SelectedBg" Color="#3D5EB2FF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="CardBg" Color="#CC1E1E1E"/>
        <SolidColorBrush x:Key="BtnBg" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="BtnBgHover" Color="#3DFFFFFF"/>
        <SolidColorBrush x:Key="AccentBg" Color="#2A6DF4"/>

        <Style x:Key="MacButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnBgHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource MacButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBg}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="7,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 选择题选项按钮 -->
        <Style x:Key="OptionChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{DynamicResource BtnBg}" CornerRadius="9" Padding="12,6" Margin="0,0,6,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnBgHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBg}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主题化下拉框（与设置窗口类型下拉一致）：跟随深浅色主题 -->
        <Style x:Key="MacCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{DynamicResource BtnBg}" CornerRadius="7"
                                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnBgHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="10,0,22,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              IsHitTestVisible="False"/>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}" Padding="4">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Setter Property="Padding" Value="9,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard" CornerRadius="24" BorderThickness="1"
            BorderBrush="{DynamicResource CardBorder}"
            Background="{DynamicResource CardBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="✨" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock Text="AI 助手" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <ComboBox x:Name="SessionCombo" Style="{StaticResource MacCombo}" Width="190" Height="28"
                              Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Visibility="Collapsed"
                              SelectionChanged="OnSessionChanged"/>
                    <Button x:Name="RefreshSessionsBtn" Style="{StaticResource GhostButton}" Click="OnRefreshSessions"
                            ToolTip="刷新会话列表" Visibility="Collapsed">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ModelText" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,1,10,0"/>
                    <Button x:Name="NewSessionBtn" Style="{StaticResource MacButton}" Content="新建会话" Click="OnClearOrNew" Margin="0,0,8,0"/>
                    <Button x:Name="CloseBtn" Style="{StaticResource GhostButton}" Click="OnClose">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource SeparatorBrush}"/>

            <!-- 消息区 -->
            <ScrollViewer x:Name="MsgScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,12">
                <ItemsControl x:Name="MsgList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Border x:Name="Bubble" MaxWidth="430" CornerRadius="13" Padding="11,8"
                                        HorizontalAlignment="{Binding Align}" Background="{Binding BubbleBg}">
                                    <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap"
                                               Foreground="{Binding TextColor}"/>
                                </Border>
                                <TextBlock x:Name="StatusText" Text="{Binding Text}" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                           Visibility="Collapsed" Margin="4,1"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="status">
                                    <Setter TargetName="StatusText" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Bubble" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 授权 / 提问操作条 -->
            <Border x:Name="ActionBar" Grid.Row="3" Margin="14,4,14,6" Visibility="Collapsed"
                    CornerRadius="9" Background="{DynamicResource BtnBg}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="12,9">
                <StackPanel>
                    <TextBlock x:Name="ActionText" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ApprovalBtns" Orientation="Horizontal" Margin="0,9,0,0" Visibility="Collapsed">
                        <Button x:Name="AllowBtn" Style="{StaticResource AccentButton}" Content="允许一次" Click="OnAllow" Margin="0,0,8,0"/>
                        <Button x:Name="RejectBtn" Style="{StaticResource MacButton}" Content="拒绝" Click="OnReject"/>
                    </StackPanel>
                    <StackPanel x:Name="QuestionBox" Margin="0,9,0,0" Visibility="Collapsed">
                        <!-- 每个问题动态渲染：问题文本 + 选项 chips + 自定义输入框（支持一次多个问题） -->
                        <StackPanel x:Name="QuestionList"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button x:Name="AnswerSendBtn" Style="{StaticResource AccentButton}" Content="提交" Click="OnAnswerSend"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Rectangle Grid.Row="4" Height="1" Fill="{DynamicResource SeparatorBrush}"/>

            <!-- 输入区 -->
            <Grid Grid.Row="5" Margin="14,10,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" MinHeight="38" MaxHeight="96" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="OnInputPreviewKeyDown" Padding="10,7" FontSize="13"
                         Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                         Background="{DynamicResource BtnBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="8,5" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Bottom">
                    <Button x:Name="StopBtn" Style="{StaticResource MacButton}" Content="停止" Click="OnStop"
                            Visibility="Collapsed" Margin="0,0,8,0"/>
                    <Button x:Name="SendBtn" Style="{StaticResource AccentButton}" Content="发送" Click="OnSend"
                            ToolTip="Enter 发送 · Shift+Enter 换行" MinWidth="64"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
