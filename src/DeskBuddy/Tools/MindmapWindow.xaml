<Window x:Class="DeskBuddy.Tools.MindmapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连连看"
        Width="1220" Height="740" MinWidth="960" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" Topmost="False"
        WindowStartupLocation="CenterScreen"
        PreviewMouseWheel="OnPreviewMouseWheel"
        PreviewKeyDown="OnWindowKeyDown">
    <Window.Resources>
        <!-- ===== Monet 设计 token（深色） ===== -->
        <SolidColorBrush x:Key="BgBase" Color="#141414"/>
        <SolidColorBrush x:Key="BgSurface" Color="#1C1C1C"/>
        <SolidColorBrush x:Key="BgFloat" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="Border" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="Accent" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentBg" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="DotBrush" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="ColorDanger" Color="#FF6E6E"/>
        <SolidColorBrush x:Key="ColorSuccess" Color="#82DC96"/>
        <SolidColorBrush x:Key="ColorWarning" Color="#F0B450"/>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBg}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent" Width="38" Height="38">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBg}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="24" Height="24" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Border}" BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 节点库列表项 -->
        <Style x:Key="LibItem" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" Padding="10,8" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBg}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1"
            Background="{StaticResource BgBase}" ClipToBounds="True">
        <DockPanel>
            <!-- ===== 顶部工具条 ===== -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="10,8"
                    MouseLeftButtonDown="OnTitlebarDown" MouseMove="OnTitlebarMove" MouseLeftButtonUp="OnTitlebarUp">
                <DockPanel>
                    <TextBlock Text="连连看" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <TextBlock x:Name="DocNameText" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="新建" Click="OnNew" Style="{StaticResource Btn}"/>
                        <Button Content="打开" Click="OnOpen" Style="{StaticResource Btn}"/>
                        <Button Content="保存" Click="OnSave" Style="{StaticResource Btn}"/>
                        <Button Content="导出" Click="OnExport" Style="{StaticResource Btn}"/>
                        <Rectangle Width="1" Height="18" Fill="{StaticResource Border}" VerticalAlignment="Center" Margin="6,0"/>
                        <Button Content="↺" ToolTip="撤销 (Ctrl+Z)" Click="OnUndo" Style="{StaticResource Btn}" FontSize="14"/>
                        <Button Content="↻" ToolTip="重做 (Ctrl+Y)" Click="OnRedo" Style="{StaticResource Btn}" FontSize="14"/>
                        <Rectangle Width="1" Height="18" Fill="{StaticResource Border}" VerticalAlignment="Center" Margin="6,0"/>
                        <Button Content="▶ 运行" Click="OnRun" Style="{StaticResource Btn}" Foreground="{StaticResource ColorSuccess}"/>
                        <Button Content="■ 终止" Click="OnStop" Style="{StaticResource Btn}" Foreground="{StaticResource ColorDanger}"/>
                        <Rectangle Width="1" Height="18" Fill="{StaticResource Border}" VerticalAlignment="Center" Margin="6,0"/>
                        <Button Content="−" Click="OnZoomOut" Style="{StaticResource Btn}" FontSize="15"/>
                        <TextBlock x:Name="ZoomText" Text="100%" FontSize="11" VerticalAlignment="Center" Width="42" TextAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                        <Button Content="＋" Click="OnZoomIn" Style="{StaticResource Btn}" FontSize="15"/>
                        <Button Content="✕" Click="OnClose" ToolTip="关闭" Style="{StaticResource Btn}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== 主体：左节点库 | 画布 | 右属性 ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <!-- 左：工具 + 节点库 -->
                <Border Grid.Column="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,10,8,6">
                            <Button x:Name="ToolSelect" Content="🖱" ToolTip="选择/移动 (V)" Style="{StaticResource ToolBtn}" Width="34" Height="34"/>
                            <Button x:Name="ToolAdd" Content="＋" ToolTip="添加节点 (N)" Click="OnToolAdd" Style="{StaticResource ToolBtn}" Width="34" Height="34" Margin="4,0,0,0"/>
                            <Button x:Name="ToolLink" Content="⌁" ToolTip="连线 (L)" Style="{StaticResource ToolBtn}" Width="34" Height="34" Margin="4,0,0,0"/>
                            <Button x:Name="BtnFit" Content="⛶" ToolTip="自适应视图" Click="OnFitView" Style="{StaticResource ToolBtn}" Width="34" Height="34" Margin="4,0,0,0"/>
                        </StackPanel>
                        <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource Border}" Margin="8,0"/>
                        <TextBlock DockPanel.Dock="Top" Text="节点库" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="10,10,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="NodeLibPanel" Margin="8,0,8,10"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 画布（点阵 + 缩放平移） -->
                <Grid Grid.Column="1" ClipToBounds="True">
                    <Grid.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="{StaticResource BgBase}">
                                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,28,28"/></GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="{StaticResource DotBrush}">
                                        <GeometryDrawing.Geometry><EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1"/></GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>
                    <Canvas x:Name="CanvasHost" Background="Transparent"
                            MouseDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove" MouseUp="OnCanvasMouseUp" MouseLeave="OnCanvasMouseLeave">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ZoomTf"/>
                                <TranslateTransform x:Name="PanTf"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Canvas x:Name="LinkCanvas"/>
                        <Canvas x:Name="NodeCanvas"/>
                        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>
                    </Canvas>
                    <Border x:Name="ResizeGrip" Width="22" Height="22" Background="Transparent" Cursor="SizeNWSE"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                            MouseLeftButtonDown="OnResizeGripDown" MouseMove="OnWindowResizeMove" MouseLeftButtonUp="OnResizeGripUp">
                        <Path Data="M 4,18 L 18,4 M 4,12 L 12,4 M 4,6 L 6,4" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="2"/>
                    </Border>
                </Grid>

                <!-- 右属性面板 -->
                <Border Grid.Column="2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,14" VerticalAlignment="Top">
                            <TextBlock x:Name="PropTitle" Text="属性" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                            <TextBlock Text="节点参数" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                            <StackPanel x:Name="PropParamPanel"/>
                            <TextBlock Text="颜色" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,14,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="Swatch1" Click="OnPickColor" Tag="#FF3A3A3C" Style="{StaticResource Swatch}"/>
                                <Button x:Name="Swatch2" Click="OnPickColor" Tag="#FF2563EB" Style="{StaticResource Swatch}" Margin="6,0,0,0"/>
                                <Button x:Name="Swatch3" Click="OnPickColor" Tag="#FF30D158" Style="{StaticResource Swatch}" Margin="6,0,0,0"/>
                                <Button x:Name="Swatch4" Click="OnPickColor" Tag="#FFF97316" Style="{StaticResource Swatch}" Margin="6,0,0,0"/>
                                <Button x:Name="Swatch5" Click="OnPickColor" Tag="#FF8B5CF6" Style="{StaticResource Swatch}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="字体大小" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,14,0,6"/>
                            <Slider x:Name="PropFontSize" Minimum="12" Maximum="40" Value="24" TickFrequency="1" Width="210" ValueChanged="OnFontSizeChanged"/>
                            <Rectangle Height="1" Fill="{StaticResource Border}" Margin="0,16"/>
                            <TextBlock Text="线宽" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                            <Slider x:Name="PropThickness" Minimum="1" Maximum="12" Value="4" TickFrequency="1" Width="210" ValueChanged="OnThicknessChanged"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>