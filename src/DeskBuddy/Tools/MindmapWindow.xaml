<Window x:Class="DeskBuddy.Tools.MindmapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连连看"
        Width="1180" Height="720" MinWidth="900" MinHeight="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" Topmost="False"
        WindowStartupLocation="CenterScreen"
        PreviewMouseWheel="OnPreviewMouseWheel"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A8A8B0"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="BtnBg" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="BtnBgHover" Color="#32FFFFFF"/>
        <SolidColorBrush x:Key="CardBg" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="CanvasBg" Color="#17181A"/>
        <SolidColorBrush x:Key="DotBrush" Color="#223F3F46"/>
        <SolidColorBrush x:Key="Accent" Color="#4A90FF"/>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnBgHover}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 工具条按钮（图标独占） -->
        <Style x:Key="ToolBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent" Width="38" Height="38">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnBgHover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="Background" Value="#244A90FF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <Style x:Key="Swatch" TargetType="Button">
                            <Setter Property="Width" Value="24"/>
                            <Setter Property="Height" Value="24"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Width="24" Height="24" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="#99FFFFFF" BorderThickness="1">
                                            <Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.3"/></Border.Effect>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
    </Window.Resources>

    <Border CornerRadius="16" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            Background="{DynamicResource CardBg}" ClipToBounds="True">
        <DockPanel>
            <!-- ===== 顶部工具条 ===== -->
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="8,6"
                MouseLeftButtonDown="OnTitlebarDown" MouseMove="OnTitlebarMove" MouseLeftButtonUp="OnTitlebarUp" Background="Transparent">
                <DockPanel>
                    <TextBlock Text="连连看" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="6,0,10,0"/>
                    <TextBlock x:Name="DocNameText" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="新建" Click="OnNew" Style="{StaticResource Btn}"/>
                        <Button Content="打开" Click="OnOpen" Style="{StaticResource Btn}"/>
                        <Button Content="保存" Click="OnSave" Style="{StaticResource Btn}"/>
                        <Button Content="导出" Click="OnExport" Style="{StaticResource Btn}"/>
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource CardBorder}" VerticalAlignment="Center" Margin="6,0"/>
                        <Button Content="⟲" ToolTip="撤销 (Ctrl+Z)" Click="OnUndo" Style="{StaticResource Btn}" FontSize="14"/>
                        <Button Content="⟳" ToolTip="重做 (Ctrl+Y)" Click="OnRedo" Style="{StaticResource Btn}" FontSize="14"/>
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource CardBorder}" VerticalAlignment="Center" Margin="6,0"/>
                        <Button Content="−" Click="OnZoomOut" Style="{StaticResource Btn}" FontSize="15"/>
                        <TextBlock x:Name="ZoomText" Text="100%" FontSize="11" VerticalAlignment="Center" Width="44" TextAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                        <Button Content="＋" Click="OnZoomIn" Style="{StaticResource Btn}" FontSize="15"/>
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource CardBorder}" VerticalAlignment="Center" Margin="6,0"/>
                        <Button Content="✕" Click="OnClose" ToolTip="关闭" Style="{StaticResource Btn}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== 主体：左工具条 | 画布 | 右属性 ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <!-- 左工具条 -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="6,10" VerticalAlignment="Top">
                        <RadioButton x:Name="ToolSelect" GroupName="tool" IsChecked="True" Style="{StaticResource ToolBtn}" ToolTip="选择/移动 (V)" Content="🖱️"/>
                        <RadioButton x:Name="ToolNode" GroupName="tool" Style="{StaticResource ToolBtn}" ToolTip="新建节点 (N)" Content="＋" Click="OnToolNode"/>
                        <RadioButton x:Name="ToolLink" GroupName="tool" Style="{StaticResource ToolBtn}" ToolTip="连线 (L)" Content="—"/>
                        <RadioButton x:Name="ToolErase" GroupName="tool" Style="{StaticResource ToolBtn}" ToolTip="删除 (E)" Content="🗑"/>
                        <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="4,4"/>
                        <Button x:Name="BtnAddColor" Content="🎨" ToolTip="改选中节点颜色" Style="{StaticResource Btn}" Click="OnCycleColor" FontSize="16"/>
                    </StackPanel>
                </Border>

                <!-- 画布 -->
                <Grid Grid.Column="1" ClipToBounds="True">
                    <!-- 深色玻璃底 + 点阵网格（单一 DrawingBrush 含底+点） -->
                    <Grid.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="{DynamicResource CanvasBg}">
                                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,24"/></GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="{DynamicResource DotBrush}">
                                        <GeometryDrawing.Geometry><EllipseGeometry Center="1.4,1.4" RadiusX="1.4" RadiusY="1.4"/></GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>
                    <Canvas x:Name="CanvasHost" Background="Transparent"
                            MouseDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove" MouseUp="OnCanvasMouseUp" MouseLeave="OnCanvasMouseLeave">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ZoomTf"/>
                                <TranslateTransform x:Name="PanTf"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Canvas x:Name="LinkCanvas" IsHitTestVisible="False"/>
                        <Canvas x:Name="NodeCanvas"/>
                        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>
                    </Canvas>
                    <!-- 右下 resize grip -->
                    <Border x:Name="ResizeGrip" Width="22" Height="22" Background="Transparent" Cursor="SizeNWSE"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                            MouseLeftButtonDown="OnResizeGripDown" MouseMove="OnWindowResizeMove" MouseLeftButtonUp="OnResizeGripUp">
                        <Path Data="M 4,18 L 18,4 M 4,12 L 12,4 M 4,6 L 6,4" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="2"/>
                    </Border>
                </Grid>

                <!-- 右侧属性面板 -->
                <Border Grid.Column="2" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0" Background="{DynamicResource CardBg}">
                    <StackPanel Margin="12,12" VerticalAlignment="Top">
                        <TextBlock x:Name="PropTitle" Text="属性" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <!-- 节点属性 -->
                        <TextBlock x:Name="LblNode" Text="节点" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="PropText" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource BtnBg}"
                                 BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="7,5" TextChanged="OnPropTextChanged"/>
                        <TextBlock Text="颜色" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Margin="0,12,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="Swatch1" Click="OnPickColor" Tag="#FFA7AEB8" Style="{StaticResource Swatch}"/>
                            <Button x:Name="Swatch2" Click="OnPickColor" Tag="#FFFF453A" Style="{StaticResource Swatch}" Margin="6,0,0,0"/>
                            <Button x:Name="Swatch3" Click="OnPickColor" Tag="#FF30D158" Style="{StaticResource Swatch}" Margin="6,0,0,0"/>
                            <Button x:Name="Swatch4" Click="OnPickColor" Tag="#FFFF9F0A" Style="{StaticResource Swatch}" Margin="6,0,0,0"/>
                            <Button x:Name="Swatch5" Click="OnPickColor" Tag="#FFBF5AF2" Style="{StaticResource Swatch}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="0,14"/>
                        <!-- 连线属性 -->
                        <TextBlock x:Name="LblLink" Text="连线" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <CheckBox x:Name="PropArrow" Content="箭头" FontSize="12" Foreground="{DynamicResource TextPrimary}" Checked="OnArrowChanged" Unchecked="OnArrowChanged"/>
                        <TextBlock Text="线宽" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,4"/>
                        <Slider x:Name="PropThickness" Minimum="1" Maximum="6" Value="1.6" TickFrequency="0.5" Width="200" ValueChanged="OnThicknessChanged"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>