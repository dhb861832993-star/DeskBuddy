<Window x:Class="DeskBuddy.Tools.MindmapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连连看"
        Width="1000" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="True" Topmost="False"
        WindowStartupLocation="CenterScreen"
        PreviewMouseWheel="OnPreviewMouseWheel"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A8A8B0"/>
        <SolidColorBrush x:Key="CardBorder" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="BtnBg" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="BtnBgHover" Color="#3DFFFFFF"/>
        <SolidColorBrush x:Key="CardBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="CanvasBg" Color="#141414"/>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnBgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="14" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            Background="{DynamicResource CardBg}" ClipToBounds="True">
        <DockPanel>
            <!-- 顶部工具栏 -->
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="10,8">
                <DockPanel>
                    <TextBlock Text="🌳 连连看" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <TextBlock x:Name="DocNameText" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="新建" Click="OnNew" Margin="0,0,6,0" Style="{StaticResource ToolBtn}"/>
                        <Button Content="打开" Click="OnOpen" Margin="0,0,6,0" Style="{StaticResource ToolBtn}"/>
                        <Button Content="保存" Click="OnSave" Margin="0,0,6,0" Style="{StaticResource ToolBtn}"/>
                        <Button Content="导出" Click="OnExport" Margin="0,0,6,0" Style="{StaticResource ToolBtn}"/>
                        <Button Content="历史" Click="OnHistory" Margin="0,0,6,0" Style="{StaticResource ToolBtn}"/>
                        <Button x:Name="BtnClose" Content="✕" Click="OnClose" Padding="10,4" Style="{StaticResource ToolBtn}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 画布容器：ClipToBounds，背景可命中 -->
            <Grid x:Name="CanvasHost" Background="{DynamicResource CanvasBg}" ClipToBounds="True"
                  MouseDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove" MouseUp="OnCanvasMouseUp" MouseLeave="OnCanvasMouseLeave">
                <!-- CanvasGroup 统一承载节点与连线，缩放+平移都在这一层 -->
                <Canvas x:Name="CanvasGroup">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ZoomTf" CenterX="0" CenterY="0"/>
                            <TranslateTransform x:Name="PanTf"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Canvas x:Name="LinkCanvas"/>
                    <Canvas x:Name="NodeCanvas"/>
                </Canvas>

                <!-- 缩放控件 -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,16,12">
                    <Button Content="−" Click="OnZoomOut" Width="30" Height="30" Style="{StaticResource ToolBtn}"/>
                    <TextBlock x:Name="ZoomText" Text="100%" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                               Width="46" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="＋" Click="OnZoomIn" Width="30" Height="30" Style="{StaticResource ToolBtn}"/>
                </StackPanel>

                <!-- 右下角窗口 resize 手柄（无边框窗口没有系统手柄，自绘一个） -->
                <Border x:Name="ResizeGrip" Width="22" Height="22" Background="Transparent"
                        Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,6,6" MouseLeftButtonDown="OnResizeGripDown"
                        MouseMove="OnWindowResizeMove" MouseLeftButtonUp="OnResizeGripUp">
                    <Path Data="M 4,18 L 18,4 M 4,12 L 12,4 M 4,6 L 6,4" Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="2"/>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>