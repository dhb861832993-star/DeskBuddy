<Window x:Class="DeskBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBuddy"
        Width="680" Height="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False"
        Deactivated="OnDeactivated" Activated="OnActivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A8A8B0"/>
        <SolidColorBrush x:Key="HoverBg" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="SelectedBg" Color="#3D5EB2FF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="SearchGlyphBrush" Color="#A8A8B0"/>

        <!-- AI 标识渐变（紫→蓝→绿） -->
        <LinearGradientBrush x:Key="AiGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7A5CFF" Offset="0"/>
            <GradientStop Color="#2A6DF4" Offset="0.55"/>
            <GradientStop Color="#32D583" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="FooterBrush" Color="#909098"/>
        <SolidColorBrush x:Key="CardBg" Color="#CC1E1E1E"/>

        <Style x:Key="GlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 右键菜单项按钮 -->
        <Style x:Key="MenuItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 宫格（现状）容器：固定磁贴尺寸 -->
        <Style x:Key="TileContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                Padding="6,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 文件分区头：通栏分隔条，不可点击/不可选中 -->
                <DataTrigger Binding="{Binding Kind}" Value="file-section">
                    <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 列表容器：通栏行 -->
        <Style x:Key="ListContainerStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="file-section">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Padding" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 磁贴模板（宫格） -->
        <DataTemplate x:Key="TileTemplate">
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Subtitle}">
                <StackPanel x:Name="Tile">
                    <Border Width="52" Height="52" CornerRadius="13"
                            Background="{Binding IconBg}" HorizontalAlignment="Center">
                        <Grid>
                            <Image x:Name="IconImage" Source="{Binding Icon}" Stretch="Uniform" Margin="5"/>
                            <TextBlock x:Name="GlyphText" Text="{Binding Glyph}"
                                       Style="{StaticResource GlyphStyle}" FontSize="22" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" MaxWidth="84"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <Grid x:Name="FileDivider" Visibility="Collapsed" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Height="1" Fill="{DynamicResource SeparatorBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">
                        <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource SeparatorBrush}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="GlyphText" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="file-section">
                    <Setter TargetName="Tile" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FileDivider" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 列表行模板 -->
        <DataTemplate x:Key="ListRowTemplate">
            <Grid MinHeight="42" ToolTip="{Binding Subtitle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="TileRow" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{Binding IconBg}">
                        <Grid>
                            <Image x:Name="ListIcon" Source="{Binding Icon}" Stretch="Uniform" Margin="4"/>
                            <TextBlock x:Name="ListGlyph" Text="{Binding Glyph}"
                                       Style="{StaticResource GlyphStyle}" FontSize="16" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Grid x:Name="ListDivider" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Height="1" Fill="{DynamicResource SeparatorBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">
                        <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource SeparatorBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="ListGlyph" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ListIcon" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="file-section">
                    <Setter TargetName="TileRow" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ListDivider" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 文件搜索结果行：图标 + 名称 + 路径 + 修改时间 -->
        <DataTemplate x:Key="FileRowTemplate">
            <Grid MinHeight="42" ToolTip="{Binding Subtitle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="8" Background="{Binding IconBg}">
                    <Grid>
                        <Image x:Name="FileRowIcon" Source="{Binding Icon}" Stretch="Uniform" Margin="3"/>
                        <TextBlock x:Name="FileRowGlyph" Text="{Binding Glyph}"
                                   Style="{StaticResource GlyphStyle}" FontSize="15" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                               Foreground="{DynamicResource TextSecondary}"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="10"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="FileRowGlyph" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="FileRowIcon" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border x:Name="RootCard" CornerRadius="26" BorderThickness="1"
                BorderBrush="{DynamicResource CardBorder}"
                Background="{DynamicResource CardBg}"
                AllowDrop="True"
                PreviewMouseLeftButtonDown="OnRootPreviewMouseDown"
                DragEnter="OnMenuDragEnter" DragOver="OnMenuDragOver"
                DragLeave="OnMenuDragLeave" Drop="OnMenuDrop">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ===== 搜索栏 ===== -->
            <Grid Grid.Row="0">
                <TextBlock Text="&#xE721;" Style="{StaticResource GlyphStyle}"
                           Foreground="{DynamicResource SearchGlyphBrush}" FontSize="14"
                           Margin="22,0,0,0" HorizontalAlignment="Left"/>
                <Grid Margin="48,0,54,0">
                    <TextBox x:Name="SearchBox" TextChanged="OnSearchTextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="2,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="Transparent" CornerRadius="8">
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="1,0" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock x:Name="Placeholder" Text="搜索应用、网页、文件夹…"
                               FontSize="16" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <Button x:Name="AiBtn" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,13,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="AI 助手" Click="OnAiClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="11" Padding="2">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <!-- 彩色渐变徽章，一眼可见 -->
                    <Border CornerRadius="9" Padding="9,4" Background="{StaticResource AiGradient}">
                        <TextBlock Text="✨" FontSize="13" Foreground="White"/>
                    </Border>
                </Button>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Margin="16,0" Fill="{DynamicResource SeparatorBrush}"/>

            <!-- ===== 条目列表 ===== -->
            <Grid Grid.Row="2">
                <StackPanel>
                    <ListBox x:Name="ItemList" Margin="10,8,10,4"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="OnListPreviewLeftDown"
                             PreviewMouseMove="OnListPreviewMouseMove"
                             PreviewMouseLeftButtonUp="OnListMouseUp"
                             PreviewMouseRightButtonUp="OnListPreviewRightUp"
                             MouseDoubleClick="OnListDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="TileContainerStyle"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <StaticResource ResourceKey="TileTemplate"/>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ===== 文件搜索结果（独立列表：名称 + 路径 + 修改时间，最新在前） ===== -->
                    <StackPanel x:Name="FileSection" Visibility="Collapsed">
                        <TextBlock x:Name="FileSectionTitle" Margin="16,6,16,4" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <ListBox x:Name="FileList" Margin="10,0,10,6" MaxHeight="620"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonUp="OnFileListMouseUp"
                                 PreviewMouseRightButtonUp="OnListPreviewRightUp">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <StaticResource ResourceKey="ListContainerStyle"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <StaticResource ResourceKey="FileRowTemplate"/>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="EmptyHint" Click="OnAiClick" Visibility="Collapsed"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="14,8">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="EmptyHintText" Text="没有匹配的条目" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"/>
                </Button>
            </Grid>

            <!-- ===== 底部提示 ===== -->
            <Grid Grid.Row="3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="SettingsBtn" ToolTip="设置" Click="OnSettingsClick"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,3">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource FooterBrush}"/>
                    </Button>
                    <TextBlock x:Name="CountText" FontSize="11" Foreground="{DynamicResource FooterBrush}"
                               VerticalAlignment="Center" Margin="2,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="FooterHint" FontSize="11" Foreground="{DynamicResource FooterBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,18,0"/>
            </Grid>

            <!-- 拖拽添加提示层 -->
            <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                    CornerRadius="14" BorderBrush="{DynamicResource CardBorder}" BorderThickness="2.5"
                    Margin="4" Background="#660A84FF">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="松开以添加到菜单" FontSize="15" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        </Border>

        <!-- 图标右键操作菜单 -->
        <Popup x:Name="ItemMenuPopup" Placement="MousePoint" AllowsTransparency="True"
               StaysOpen="True" PopupAnimation="Fade">
            <Border x:Name="ItemMenuRoot" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{DynamicResource CardBorder}"
                    Background="{DynamicResource CardBg}" MinWidth="158" Padding="5">
                <StackPanel>
                    <Button x:Name="CtxTop" Style="{StaticResource MenuItemButton}" Click="OnCtxTop">
                        <TextBlock Text="移到开头" FontSize="13"/>
                    </Button>
                    <Button x:Name="CtxUp" Style="{StaticResource MenuItemButton}" Click="OnCtxUp">
                        <TextBlock Text="上移" FontSize="13"/>
                    </Button>
                    <Button x:Name="CtxDown" Style="{StaticResource MenuItemButton}" Click="OnCtxDown">
                        <TextBlock Text="下移" FontSize="13"/>
                    </Button>
                    <Button x:Name="CtxBottom" Style="{StaticResource MenuItemButton}" Click="OnCtxBottom">
                        <TextBlock Text="移到最后" FontSize="13"/>
                    </Button>
                    <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}" Margin="8,4"/>
                    <Button x:Name="CtxEdit" Style="{StaticResource MenuItemButton}" Click="OnCtxEdit">
                        <TextBlock Text="编辑…" FontSize="13"/>
                    </Button>
                    <Button x:Name="CtxDelete" Style="{StaticResource MenuItemButton}" Click="OnCtxDelete">
                        <Button.Foreground>
                            <SolidColorBrush Color="#FF453A"/>
                        </Button.Foreground>
                        <TextBlock x:Name="CtxDeleteText" Text="删除" FontSize="13" Foreground="#FF453A"/>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 文件搜索结果右键菜单 -->
        <Popup x:Name="FileMenuPopup" Placement="MousePoint" AllowsTransparency="True"
               StaysOpen="True" PopupAnimation="Fade">
            <Border CornerRadius="10" BorderThickness="1"
                    BorderBrush="{DynamicResource CardBorder}"
                    Background="{DynamicResource CardBg}" MinWidth="172" Padding="5">
                <StackPanel>
                    <Button x:Name="OpenFileBtn" Style="{StaticResource MenuItemButton}" Click="OnOpenFile">
                        <TextBlock Text="打开" FontSize="13"/>
                    </Button>
                    <Button x:Name="OpenFolderBtn" Style="{StaticResource MenuItemButton}" Click="OnOpenFileFolder">
                        <TextBlock Text="打开文件所在目录" FontSize="13"/>
                    </Button>
                    <Button x:Name="CopyPathBtn" Style="{StaticResource MenuItemButton}" Click="OnCopyFilePath">
                        <TextBlock Text="复制文件路径" FontSize="13"/>
                    </Button>
                    <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}" Margin="8,4"/>
                    <Button x:Name="RenameFileBtn" Style="{StaticResource MenuItemButton}" Click="OnRenameFile">
                        <TextBlock Text="重命名…" FontSize="13"/>
                    </Button>
                    <Button x:Name="DeleteFileBtn" Style="{StaticResource MenuItemButton}" Click="OnDeleteFile">
                        <Button.Foreground>
                            <SolidColorBrush Color="#FF453A"/>
                        </Button.Foreground>
                        <TextBlock x:Name="DeleteFileBtnText" Text="删除" FontSize="13" Foreground="#FF453A"/>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
