<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>QuickMenu</AssemblyName>
    <RootNamespace>QuickMenu</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.8.2</Version>
    <FileVersion>1.8.2.0</FileVersion>
    <Product>QuickMenu 快启</Product>
    <Description>双击热键快速呼出启动菜单（苹果风格快速启动器）</Description>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 移除隐式 using，避免 System.Windows.Forms / System.Drawing 与 WPF 的类型歧义 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
